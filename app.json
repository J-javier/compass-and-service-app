{
  "expo": {
    "name": "Compass & HS App",
    "slug": "compass-hs",
    "scheme": "com.fundaciondevalores.sigef",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Permite el acceso a la cámara para tomar las fotos de evidencia de tus horas de servicio.",
          "photosPermission": "Permite el acceso a tus fotos para adjuntar la evidencia de tus horas de servicio.",
          "microphonePermission": false
        }
      ]
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B2545"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fundaciondevalores.sigef"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-mono.png",
        "backgroundColor": "#0B2545"
      },
      "package": "com.fundaciondevalores.sigef"
    }
  }
}
